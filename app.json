{
  "expo": {
    "name": "Evrida",
    "description": "Every day with Evrida",
    "slug": "evrida",
    "scheme": "evrida",
    "version": "0.1.0",
    "icon": "./assets/brand/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "./plugins/with-windows-cmake.cjs",
      "./plugins/with-gradle-memory.cjs",
      "./plugins/with-android-release.cjs",
      "expo-notifications",
      "expo-sharing",
      "expo-system-ui",
      "@react-native-community/datetimepicker",
      ["expo-splash-screen", {
        "image": "./assets/brand/splash-light.png",
        "imageWidth": 112,
        "backgroundColor": "#FAF7F2",
        "dark": { "image": "./assets/brand/splash-dark.png", "backgroundColor": "#0E1118" }
      }]
    ],
    "android": {
      "package": "com.nishef.evrida",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/monochrome.png",
        "backgroundColor": "#14182B"
      },
      "blockedPermissions": ["android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE", "android.permission.SYSTEM_ALERT_WINDOW"],
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.nishef.evrida",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
